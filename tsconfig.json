{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "omni-rich-text": ["./src/core/index.ts"],
      "omni-rich-text/core": ["./src/core/index.ts"],
      "omni-rich-text/taro": ["./src/taro/index.ts"],
      "omni-rich-text/uni": ["./src/uni/index.ts"],
      "omni-rich-text/react-native": ["./src/react-native/index.ts"],
      "omni-rich-text/rn": ["./src/react-native/index.ts"]
    }
  },
  "include": ["src/**/*"]
}
