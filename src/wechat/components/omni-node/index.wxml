<!--
  omni-node: Universal Rich Text Node Renderer for Native WeChat Mini Program
  Recursion is achieved by self-referencing via usingComponents in index.json.
-->

<!-- ① Skip nodes marked as ignored (wx:voice, mp-miniprogram, etc.) -->
<block wx:if="{{node.extra.wxIgnored}}"></block>

<!-- ② Text Leaf Node -->
<text
  wx:elif="{{node.type === 'text'}}"
  class="omni-text"
  style="{{node.styleStr}}"
  bindlongpress="onTextLongPress"
>{{node.text}}</text>

<!-- ③-A SVG Carousel / Slider (Native Swiper mapping) -->
<view
  wx:elif="{{node.extra.isSvgCarousel && node.extra.carouselSlides && node.extra.carouselSlides.length > 0}}"
  class="omni-svg-carousel-container"
  style="width:100%;margin:24rpx 0;border-radius:16rpx;overflow:hidden;position:relative;{{node.styleStr}}"
>
  <swiper
    class="omni-svg-swiper"
    indicator-dots="{{node.extra.carouselSlides.length > 1}}"
    indicator-color="rgba(255, 255, 255, 0.45)"
    indicator-active-color="#ffffff"
    autoplay="{{false}}"
    circular="{{node.extra.carouselSlides.length > 1}}"
    style="width:100%;height:480rpx;aspect-ratio:{{node.extra.aspectRatio || 1.7778}};"
  >
    <swiper-item
      wx:for="{{node.extra.carouselSlides}}"
      wx:key="index"
      style="width:100%;height:100%;"
    >
      <view
        style="width:100%;height:100%;position:relative;"
        catch:tap="onSlideTap"
        data-src="{{item.src}}"
        data-href="{{item.href}}"
      >
        <image
          src="{{item.src}}"
          mode="aspectFill"
          style="width:100%;height:100%;display:block;"
        />
        <view
          wx:if="{{item.title}}"
          style="position:absolute;bottom:0;left:0;right:0;padding:12rpx 20rpx;background:linear-gradient(transparent,rgba(0,0,0,0.65));color:#ffffff;font-size:24rpx;"
        >
          <text>{{item.title}}</text>
        </view>
      </view>
    </swiper-item>
  </swiper>
</view>

<!-- ③-B SVG with ForeignObject (Dual-layer decoupling) -->
<view
  wx:elif="{{node.name === 'svg' && node.extra.hasForeignObject}}"
  class="omni-svg-layout-wrap"
  style="position:relative;display:{{node.styleObj.display || 'block'}};width:{{node.styleObj.width || '100%'}};max-width:100%;box-sizing:border-box;{{node.extra.aspectRatio ? 'aspect-ratio:' + node.extra.aspectRatio + ';' : ''}}{{node.styleStr}}"
>
  <image
    wx:if="{{node.extra.bgSvgDataUri}}"
    class="omni-svg-layout-bg"
    src="{{node.extra.bgSvgDataUri}}"
    mode="scaleToFill"
    style="position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;"
  />
  <view
    class="omni-svg-layout-content"
    style="position:relative;z-index:1;width:100%;height:100%;box-sizing:border-box;"
  >
    <omni-node
      wx:for="{{node.extra.foreignObjectNodes}}"
      wx:key="id"
      node="{{item}}"
      theme="{{theme}}"
      imageCropMode="{{imageCropMode}}"
      imageCropRatio="{{imageCropRatio}}"
      parentLinkHref="{{parentLinkHref}}"
      imageLinkAction="{{imageLinkAction}}"
      showImageError="{{showImageError}}"
      bind:linkTap="onChildLinkTap"
      bind:imageTap="onChildImageTap"
      bind:longPressText="onChildLongPressText"
    />
  </view>
</view>

<!-- ③-C Standard Vector SVG -->
<image
  wx:elif="{{node.name === 'svg'}}"
  class="omni-svg"
  src="{{node.extra.svgDataUri}}"
  mode="widthFix"
  style="{{node.styleStr}}"
/>

<!-- ④ Anchor link <a> -->
<view
  wx:elif="{{node.name === 'a'}}"
  class="omni-link"
  style="{{node.extra.linkStyle}}"
  catch:tap="onLinkTap"
  data-href="{{node.attrs.href}}"
>
  <omni-node
    wx:for="{{node.children}}"
    wx:key="id"
    node="{{item}}"
    theme="{{theme}}"
    imageCropMode="{{imageCropMode}}"
    imageCropRatio="{{imageCropRatio}}"
    parentLinkHref="{{node.attrs.href}}"
    imageLinkAction="{{imageLinkAction}}"
    showImageError="{{showImageError}}"
    bind:linkTap="onChildLinkTap"
    bind:imageTap="onChildImageTap"
    bind:longPressText="onChildLongPressText"
  />
</view>

<!-- ⑤-A Icon / Emoji Image -->
<block wx:elif="{{node.name === 'img' && node.extra.isIcon}}">
  <view
    wx:if="{{!hasError}}"
    class="omni-image-icon-wrap"
    style="display:inline-block;vertical-align:middle;width:{{node.styleObj.width || node.attrs.width || '20px'}};height:{{node.styleObj.height || node.attrs.height || '20px'}};"
    catch:tap="onImageTap"
    data-src="{{node.attrs.src || node.attrs['data-src']}}"
    data-gallery-index="{{node.extra.galleryIndex}}"
  >
    <image
      class="omni-image-icon"
      src="{{node.attrs.src || node.attrs['data-src']}}"
      mode="aspectFit"
      binderror="onImageError"
      style="width:{{node.styleObj.width || node.attrs.width || '20px'}};height:{{node.styleObj.height || node.attrs.height || '20px'}};display:inline-block;vertical-align:middle;"
    />
  </view>
</block>

<!-- ⑤-B Regular Image <img> with smart sizing -->
<block wx:elif="{{node.name === 'img'}}">
  <view
    wx:if="{{!hasError}}"
    class="omni-image-skeleton"
    style="display:{{effectiveImgMode === 'heightFix' ? 'inline-block' : (isFullWidth ? 'block' : 'inline-block')}};max-width:100%;min-width:0;box-sizing:border-box;vertical-align:middle;width:{{effectiveImgWidth}};{{effectiveImgHeight ? 'height:' + effectiveImgHeight + ';' : ''}}{{node.extra.skeletonStyle}}"
    catch:tap="onImageTap"
    data-src="{{node.attrs.src || node.attrs['data-src']}}"
    data-gallery-index="{{node.extra.galleryIndex}}"
  >
    <image
      class="omni-image"
      src="{{node.attrs.src || node.attrs['data-src']}}"
      mode="{{effectiveImgMode}}"
      lazy-load="{{true}}"
      binderror="onImageError"
      style="width:{{effectiveImgWidth}};max-width:100%;{{effectiveImgHeight ? 'height:' + effectiveImgHeight + ';' : ''}}display:block;"
    />
  </view>
  <view
    wx:elif="{{hasError && showImageError}}"
    class="omni-image-error"
    style="display:flex;align-items:center;justify-content:center;padding:48rpx 24rpx;background-color:#f8fafc;color:#94a3b8;font-size:24rpx;border-radius:8rpx;border:1rpx dashed #cbd5e1;min-height:160rpx;text-align:center;"
  >
    <text>{{node.attrs.alt ? '[图片加载失败: ' + node.attrs.alt + ']' : '🖼️ 图片加载失败'}}</text>
  </view>
</block>

<!-- ⑥ Video <video> -->
<video
  wx:elif="{{node.name === 'video'}}"
  class="omni-video"
  src="{{node.attrs.src}}"
  poster="{{node.attrs.poster}}"
  controls="{{node.attrs.controls !== 'false'}}"
  autoplay="{{node.attrs.autoplay === 'true'}}"
  loop="{{node.attrs.loop === 'true'}}"
  muted="{{node.attrs.muted === 'true'}}"
  style="{{node.styleStr}}"
/>

<!-- ⑦ Horizontal Rule <hr> -->
<view
  wx:elif="{{node.name === 'hr'}}"
  class="omni-hr"
  style="{{theme.hrColor ? 'background-color:' + theme.hrColor + ';' : ''}}{{node.styleStr}}"
/>

<!-- ⑧ Preformatted Code <pre> with Header Bar & SVG Dual-Mode -->
<view
  wx:elif="{{node.name === 'pre'}}"
  class="omni-pre-container"
  style="margin:24rpx 0;border-radius:16rpx;overflow:hidden;border:1rpx solid rgba(0,0,0,0.08);background-color:{{theme.codeBgColor || '#282c34'}};{{node.styleStr}}"
>
  <view
    class="omni-pre-header"
    style="display:flex;flex-direction:row;justify-content:space-between;align-items:center;padding:12rpx 24rpx;background-color:rgba(0,0,0,0.25);border-bottom:1rpx solid rgba(255,255,255,0.06);"
  >
    <text style="font-size:22rpx;color:#abb2bf;font-weight:bold;">{{node.extra.isSvgCodeBlock ? '🎨 XML / SVG' : (node.extra.lang || 'CODE')}}</text>
    <view style="display:flex;flex-direction:row;align-items:center;">
      <view
        wx:if="{{node.extra.isSvgCodeBlock && node.extra.rawSvgCode}}"
        catch:tap="onToggleSvgPreview"
        style="font-size:22rpx;padding:4rpx 16rpx;border-radius:8rpx;background-color:{{showSvgPreview ? '#07c160' : 'rgba(255,255,255,0.15)'}};color:#ffffff;margin-right:12rpx;"
      >
        <text>{{showSvgPreview ? '💻 源码' : '👁️ 预览'}}</text>
      </view>
      <view
        catch:tap="onCopyCode"
        style="font-size:22rpx;padding:4rpx 16rpx;border-radius:8rpx;background-color:rgba(255,255,255,0.15);color:#ffffff;"
      >
        <text>📋 复制</text>
      </view>
    </view>
  </view>

  <view
    wx:if="{{showSvgPreview && node.extra.svgCodeDataUri}}"
    style="padding:32rpx;background-color:#ffffff;display:flex;justify-content:center;align-items:center;"
  >
    <image
      src="{{node.extra.svgCodeDataUri}}"
      mode="widthFix"
      style="max-width:100%;display:block;"
    />
  </view>
  <scroll-view
    wx:else
    class="omni-pre-scroll"
    scroll-x="{{true}}"
    style="width:100%;box-sizing:border-box;background-color:{{theme.codeBgColor || '#282c34'}};"
  >
    <view
      class="omni-pre"
      style="color:{{theme.codeTextColor || '#abb2bf'}};min-width:100%;padding:24rpx 28rpx;box-sizing:border-box;font-family:Consolas,Monaco,monospace;font-size:26rpx;{{node.styleStr}}"
    >
      <omni-node
        wx:for="{{node.children}}"
        wx:key="id"
        node="{{item}}"
        theme="{{theme}}"
        imageCropMode="{{imageCropMode}}"
        imageCropRatio="{{imageCropRatio}}"
        parentLinkHref="{{parentLinkHref}}"
        imageLinkAction="{{imageLinkAction}}"
        showImageError="{{showImageError}}"
        bind:linkTap="onChildLinkTap"
        bind:imageTap="onChildImageTap"
        bind:longPressText="onChildLongPressText"
      />
    </view>
  </scroll-view>
</view>

<!-- ⑨ Blockquote <blockquote> -->
<view
  wx:elif="{{node.name === 'blockquote'}}"
  class="omni-blockquote"
  style="{{theme.blockquoteBorderColor ? 'border-left:6rpx solid ' + theme.blockquoteBorderColor + ';' : ''}}{{theme.blockquoteBgColor ? 'background-color:' + theme.blockquoteBgColor + ';' : ''}}{{theme.blockquoteTextColor ? 'color:' + theme.blockquoteTextColor + ';' : ''}}{{node.styleStr}}"
>
  <omni-node
    wx:for="{{node.children}}"
    wx:key="id"
    node="{{item}}"
    theme="{{theme}}"
    imageCropMode="{{imageCropMode}}"
    imageCropRatio="{{imageCropRatio}}"
    parentLinkHref="{{parentLinkHref}}"
    imageLinkAction="{{imageLinkAction}}"
    showImageError="{{showImageError}}"
    bind:linkTap="onChildLinkTap"
    bind:imageTap="onChildImageTap"
    bind:longPressText="onChildLongPressText"
  />
</view>

<!-- ⑩ Table <table> with horizontal scroll -->
<scroll-view
  wx:elif="{{node.name === 'table'}}"
  class="omni-table-scroll"
  scroll-x="{{true}}"
>
  <view class="omni-table">
    <omni-node
      wx:for="{{node.children}}"
      wx:key="id"
      node="{{item}}"
      theme="{{theme}}"
      imageCropMode="{{imageCropMode}}"
      imageCropRatio="{{imageCropRatio}}"
      parentLinkHref="{{parentLinkHref}}"
      imageLinkAction="{{imageLinkAction}}"
      showImageError="{{showImageError}}"
      bind:linkTap="onChildLinkTap"
      bind:imageTap="onChildImageTap"
      bind:longPressText="onChildLongPressText"
    />
  </view>
</scroll-view>

<!-- ⑩.1 Table Header Group <thead>, Body Group <tbody>, Footer Group <tfoot> -->
<view
  wx:elif="{{node.name === 'thead' || node.name === 'tbody' || node.name === 'tfoot'}}"
  class="omni-{{node.name}}"
  style="display:{{node.name === 'thead' ? 'table-header-group' : (node.name === 'tfoot' ? 'table-footer-group' : 'table-row-group')}};{{node.styleStr}}"
>
  <omni-node
    wx:for="{{node.children}}"
    wx:key="id"
    node="{{item}}"
    theme="{{theme}}"
    imageCropMode="{{imageCropMode}}"
    imageCropRatio="{{imageCropRatio}}"
    parentLinkHref="{{parentLinkHref}}"
    imageLinkAction="{{imageLinkAction}}"
    showImageError="{{showImageError}}"
    bind:linkTap="onChildLinkTap"
    bind:imageTap="onChildImageTap"
    bind:longPressText="onChildLongPressText"
  />
</view>

<!-- ⑪ Table Row <tr> -->
<view
  wx:elif="{{node.name === 'tr'}}"
  class="omni-tr"
  style="{{node.styleStr}}"
>
  <omni-node
    wx:for="{{node.children}}"
    wx:key="id"
    node="{{item}}"
    theme="{{theme}}"
    imageCropMode="{{imageCropMode}}"
    imageCropRatio="{{imageCropRatio}}"
    parentLinkHref="{{parentLinkHref}}"
    imageLinkAction="{{imageLinkAction}}"
    showImageError="{{showImageError}}"
    bind:linkTap="onChildLinkTap"
    bind:imageTap="onChildImageTap"
    bind:longPressText="onChildLongPressText"
  />
</view>

<!-- ⑫ Table Header <th> / Cell <td> -->
<view
  wx:elif="{{node.name === 'th' || node.name === 'td'}}"
  class="{{node.name === 'th' ? 'omni-th' : 'omni-td'}}"
  style="{{theme.tableBorderColor ? 'border:1rpx solid ' + theme.tableBorderColor + ';' : ''}}{{node.name === 'th' && theme.tableHeaderBgColor ? 'background-color:' + theme.tableHeaderBgColor + ';' : ''}}{{node.styleStr}}"
>
  <omni-node
    wx:for="{{node.children}}"
    wx:key="id"
    node="{{item}}"
    theme="{{theme}}"
    imageCropMode="{{imageCropMode}}"
    imageCropRatio="{{imageCropRatio}}"
    parentLinkHref="{{parentLinkHref}}"
    imageLinkAction="{{imageLinkAction}}"
    showImageError="{{showImageError}}"
    bind:linkTap="onChildLinkTap"
    bind:imageTap="onChildImageTap"
    bind:longPressText="onChildLongPressText"
  />
</view>

<!-- ⑬ List item <li> -->
<view
  wx:elif="{{node.name === 'li'}}"
  class="omni-li"
>
  <text class="omni-li-bullet" style="{{theme.bulletColor ? 'color:' + theme.bulletColor + ';' : ''}}">{{node.extra.bulletText || '• '}}</text>
  <view class="omni-li-content">
    <omni-node
      wx:for="{{node.children}}"
      wx:key="id"
      node="{{item}}"
      theme="{{theme}}"
      imageCropMode="{{imageCropMode}}"
      imageCropRatio="{{imageCropRatio}}"
      parentLinkHref="{{parentLinkHref}}"
      imageLinkAction="{{imageLinkAction}}"
      showImageError="{{showImageError}}"
      bind:linkTap="onChildLinkTap"
      bind:imageTap="onChildImageTap"
      bind:longPressText="onChildLongPressText"
    />
  </view>
</view>

<!-- ⑭ Line break <br> -->
<text wx:elif="{{node.name === 'br'}}" class="omni-br">\n</text>

<!-- ⑮ Generic block / inline element -->
<view
  wx:else
  class="omni-element omni-{{node.name}}"
  style="{{node.styleStr}}"
  catch:tap="onNodeTap"
>
  <omni-node
    wx:for="{{node.children}}"
    wx:key="id"
    node="{{item}}"
    theme="{{theme}}"
    imageCropMode="{{imageCropMode}}"
    imageCropRatio="{{imageCropRatio}}"
    indexInList="{{index}}"
    parentTag="{{node.name}}"
    parentLinkHref="{{parentLinkHref}}"
    imageLinkAction="{{imageLinkAction}}"
    showImageError="{{showImageError}}"
    bind:linkTap="onChildLinkTap"
    bind:imageTap="onChildImageTap"
    bind:longPressText="onChildLongPressText"
  />
</view>
