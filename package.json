{
  "name": "omni-rich-text",
  "version": "0.0.4",
  "description": "Cross-platform high-performance rich text rendering engine for Taro, UniApp, React Native, and WeChat Mini Program",
  "author": "",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "core": ["./dist/core.d.ts"],
      "taro": ["./dist/taro.d.ts"],
      "uni": ["./src/uni/index.ts"],
      "react-native": ["./dist/react-native.d.ts"],
      "rn": ["./dist/react-native.d.ts"]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.mjs",
      "require": "./dist/core.js",
      "default": "./dist/core.mjs"
    },
    "./taro": {
      "types": "./dist/taro.d.ts",
      "import": "./dist/taro.mjs",
      "require": "./dist/taro.js",
      "default": "./dist/taro.mjs"
    },
    "./uni": {
      "types": "./src/uni/index.ts",
      "import": "./src/uni/index.ts",
      "require": "./src/uni/index.ts",
      "default": "./src/uni/index.ts"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.mjs",
      "require": "./dist/react-native.js",
      "default": "./dist/react-native.mjs"
    },
    "./rn": {
      "types": "./dist/react-native.d.ts",
      "import": "./dist/react-native.mjs",
      "require": "./dist/react-native.js",
      "default": "./dist/react-native.mjs"
    },
    "./wechat/*": "./src/wechat/*"
  },
  "miniprogram": "src/wechat",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "vitest run src/core/tests",
    "test:watch": "vitest src/core/tests",
    "type-check": "tsc --noEmit",
    "demo": "npm run dev --prefix examples/playground"
  },
  "peerDependencies": {
    "@tarojs/components": ">=3.0.0",
    "@tarojs/taro": ">=3.0.0",
    "react": ">=17.0.0",
    "react-native": ">=0.70.0",
    "vue": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@tarojs/components": {
      "optional": true
    },
    "@tarojs/taro": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tarojs/components": "3.6.40",
    "@tarojs/taro": "3.6.40",
    "@types/react": "^18.2.0",
    "react": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "vue": "^3.4.0"
  }
}