:host {
  display: contents;
}

.omni-text {
  word-break: break-word;
  user-select: none;
  -webkit-user-select: none;
}

.omni-link { display: inline; }

.omni-image { width: 100%; display: block; }
.omni-image-skeleton { width: 100%; }

.omni-svg { max-width: 100%; vertical-align: middle; }

/* ─── SVG Carousel & Layout ─── */
.omni-svg-carousel-container {
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
}
.omni-svg-swiper {
  width: 100%;
}
.omni-svg-layout-wrap {
  position: relative;
  max-width: 100%;
  box-sizing: border-box;
}

/* ─── Code Block ─── */
.omni-pre-container {
  margin: 24rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}
.omni-pre-header {
  box-sizing: border-box;
}
.omni-pre-scroll { width: 100%; overflow: scroll; box-sizing: border-box; }
.omni-pre { box-sizing: border-box; }

.omni-video { width: 100%; }

.omni-hr { height: 1rpx; }

.omni-blockquote { box-sizing: border-box; }

.omni-li { display: flex; flex-direction: row; align-items: flex-start; }
.omni-li-bullet { flex-shrink: 0; }
.omni-li-content { flex: 1; }

.omni-table-scroll { width: 100%; overflow: scroll; box-sizing: border-box; }
.omni-table { width: 100%; min-width: 100%; display: table; border-collapse: collapse; box-sizing: border-box; }
.omni-thead { display: table-header-group; }
.omni-tbody { display: table-row-group; }
.omni-tfoot { display: table-footer-group; }
.omni-tr { display: table-row; }
.omni-th, .omni-td { display: table-cell; vertical-align: middle; box-sizing: border-box; }

.omni-element { box-sizing: border-box; max-width: 100%; }

.omni-span, .omni-strong, .omni-b, .omni-em, .omni-i, .omni-u, .omni-s,
.omni-del, .omni-ins, .omni-strike, .omni-sub, .omni-sup, .omni-mark,
.omni-small, .omni-big, .omni-font, .omni-label, .omni-abbr, .omni-cite,
.omni-q, .omni-time, .omni-code {
  display: inline-block;
}
